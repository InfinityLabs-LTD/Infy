# =============================================================
# Infy Messenger — Environment Variables
# Copy to .env and fill in values before running
# =============================================================

# ----- Postgres -----
POSTGRES_DB=infy
POSTGRES_USER=infy
POSTGRES_PASSWORD=change_me_db_password
DATABASE_URL=postgresql://infy:change_me_db_password@postgres:5432/infy

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- JWT -----
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_access_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ----- MinIO -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_MEDIA=media
# Public URL for generating download links (nginx media subdomain in prod)
MINIO_PUBLIC_URL=http://localhost:9000

# ----- Domain (prod only) -----
DOMAIN=example.com
# Subdomains: app.DOMAIN, api.DOMAIN, ws.DOMAIN, media.DOMAIN

# ----- Rate Limiting -----
# All values: max requests per window
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# ----- Service Role -----
# One of: core | realtime | media
SERVICE_ROLE=core

# ----- Docker Socket Proxy -----
# URL к tecnativa/docker-socket-proxy (доступен только из контейнера core)
DOCKER_PROXY_URL=http://socket-proxy:2375

# ----- Ports -----
PORT_CORE=3001
PORT_REALTIME=3002
PORT_MEDIA=3003

# ----- Web Push (VAPID) -----
# Generate with: cd backend && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ----- AI (Infy Puls) -----
# Опционально. Без ключа AI-функции отключены, остальной мессенджер работает как
# обычно. Провайдер, модель и ключи можно переопределить из админки (AI Center) —
# переменные ниже служат значениями по умолчанию / фолбэком.
# Провайдер по умолчанию: ANTHROPIC | OPENAI
AI_PROVIDER=ANTHROPIC
# Anthropic (Claude). Ключ: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Необязательно: свой базовый URL (Anthropic-совместимый прокси). Пусто = дефолт SDK.
ANTHROPIC_BASE_URL=
# OpenAI (ChatGPT). Ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Необязательно: свой базовый URL для OpenAI-совместимых провайдеров.
# Напр. https://api.artemox.com/v1 или https://openrouter.ai/api/v1. Пусто = дефолт SDK.
OPENAI_BASE_URL=

# ----- Звонки / WebRTC ICE -----
# STUN — публичные, помогают определить внешний адрес за NAT.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN — ретрансляция, когда P2P невозможен (симметричный NAT, моб. сети).
# coturn слушает в network_mode: host, поэтому клиент ходит на ПУБЛИЧНЫЙ
# адрес сервера, а не на внутреннее docker-имя. Укажи реальный IP/домен VPS:
#   TURN_URLS=turn:144.31.101.68:3478
# (или с TLS, если настроен сертификат: turns:turn.example.com:5349)
TURN_URLS=turn:144.31.101.68:3478
# Общий секрет coturn (static-auth-secret). Тот же, что в turnserver.conf.
# Сгенерировать: openssl rand -hex 32
TURN_SECRET=change_me_turn_static_auth_secret
# Сколько секунд живут выданные клиенту TURN-credentials.
TURN_TTL_SEC=3600
# Realm coturn (любая строка, обычно домен/IP сервера).
TURN_REALM=144.31.101.68
# ВНЕШНИЙ IP сервера — ОБЯЗАТЕЛЕН для relay за NAT. Без него coturn отдаёт
# relay-кандидаты с внутренним адресом и TURN не работает. На VPS = публичный IP.
TURN_EXTERNAL_IP=144.31.101.68

# ----- Node -----
NODE_ENV=development
LOG_LEVEL=info

# ----- CORS -----
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# Публичный URL фронтенда — для генерации ссылок (например, смены пароля).
# Если пусто — берётся первый из CORS_ORIGINS.
APP_PUBLIC_URL=http://localhost:5173

# ----- Nginx (trusted proxy) -----
# Real IP from nginx — trust X-Forwarded-For from this IP only
TRUSTED_PROXY=172.0.0.0/8
