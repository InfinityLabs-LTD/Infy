# Dependencies
node_modules/

# Build output
dist/
build/

# Environment secrets
.env
.env.local
.env.*.local

# Firebase service account (FCM-push). В репо лежит ПЛЕЙСХОЛДЕР {} под bind-mount
# docker-compose; реальный приватный ключ оператор кладёт на месте и помечает
# `git update-index --skip-worktree backend/fcm-service-account.json`, чтобы он
# не попал в git. См. docs/PUSH.md. Явные имена ключей service account игнорируем ВЕЗДЕ.
**/*-firebase-adminsdk-*.json
**/serviceAccountKey.json

# Logs
*.log
npm-debug.log*

# Editor
# Игнорируем содержимое .vscode/, но общие конфиги проекта (Android-сборка/
# отладка) — коммитим (негатив работает, только если исключён не сам каталог,
# а его содержимое через .vscode/*).
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db



# Local Claude Code config (содержит секреты — не коммитить)
.claude/

# Android / Gradle (сборка из корня репо, см. settings.gradle.kts)
.gradle/
local.properties
/captures/
*.iml
*.apk
*.aab
*.keystore
!debug.keystore
