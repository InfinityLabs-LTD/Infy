# =============================================================
# Infy Messenger — Environment Variables
# Copy to .env and fill in values before running
# =============================================================

# ----- Postgres -----
POSTGRES_DB=infy
POSTGRES_USER=infy
POSTGRES_PASSWORD=change_me_db_password
DATABASE_URL=postgresql://infy:change_me_db_password@postgres:5432/infy

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- JWT -----
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_access_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ----- MinIO -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_MEDIA=media
# Public URL for generating download links (nginx media subdomain in prod)
MINIO_PUBLIC_URL=http://localhost:9000

# ----- Domain (prod only) -----
DOMAIN=example.com
# Subdomains: app.DOMAIN, api.DOMAIN, ws.DOMAIN, media.DOMAIN

# ----- Rate Limiting -----
# All values: max requests per window
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# ----- Service Role -----
# One of: core | realtime | media
SERVICE_ROLE=core

# ----- Docker Socket Proxy -----
# URL к tecnativa/docker-socket-proxy (доступен только из контейнера core)
DOCKER_PROXY_URL=http://socket-proxy:2375

# ----- Ports -----
PORT_CORE=3001
PORT_REALTIME=3002
PORT_MEDIA=3003

# ----- Web Push (VAPID) -----
# Generate with: cd backend && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ----- AI (Infy Pulse) -----
# Опционально. Без ключа AI-функции (сводка диалога, умные ответы) отключены,
# остальной мессенджер работает как обычно. Ключ: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ----- Node -----
NODE_ENV=development
LOG_LEVEL=info

# ----- CORS -----
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# ----- Nginx (trusted proxy) -----
# Real IP from nginx — trust X-Forwarded-For from this IP only
TRUSTED_PROXY=172.0.0.0/8
