generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ChatType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  CIRCLE_VIDEO
  SYSTEM
}

// Кому адресовано напоминание о событии календаря
enum ReminderTarget {
  SELF      // только создателю
  PARTNER   // только второму участнику
  BOTH      // обоим
}

// Тип санкции модерации (Infy Shield)
enum SanctionType {
  WARN      // предупреждение
  MUTE      // временный запрет писать
  BAN       // блокировка аккаунта
}

// Аудио или видео — медийный режим звонка
enum CallMedia {
  AUDIO
  VIDEO
}

// Жизненный цикл звонка. RINGING → ACTIVE → ENDED либо обрыв на любом шаге.
enum CallStatus {
  RINGING    // вызов идёт, ждём ответа
  ACTIVE     // соединение установлено, идёт разговор
  ENDED      // завершён штатно (любая из сторон повесила трубку)
  MISSED     // не отвечен (таймаут или отклонён вызывающим до ответа)
  DECLINED   // получатель отклонил
  CANCELLED  // вызывающий отменил до ответа
  FAILED     // ICE/сеть не дали установить соединение
}

model User {
  id              BigInt    @id @default(autoincrement())
  username        String    @unique @db.VarChar(32)
  nickname        String    @db.VarChar(64)
  birthdate       DateTime? @db.Date
  avatarUrl       String?
  coverUrl        String?
  bio             String?   @db.VarChar(500)
  passwordHash    String
  email           String?   @unique @db.VarChar(255)
  emailVerifiedAt DateTime?
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  sessions                DeviceSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  chatMemberships         ChatMember[]
  messages                Message[]
  pushSubscriptions       PushSubscription[]
  reactions               MessageReaction[]
  createdEvents           CalendarEvent[]      @relation("EventCreator")
  createdCategories       CalendarCategory[]   @relation("CategoryCreator")
  reminderDeliveries      ReminderDelivery[]
  sanctions               Sanction[]           @relation("SanctionTarget")
  issuedSanctions         Sanction[]           @relation("SanctionIssuer")
  initiatedCalls          CallSession[]        @relation("CallInitiator")
  callParticipations      CallParticipant[]

  @@map("users")
}

// Санкция модерации (Infy Shield): бан / мут / предупреждение
model Sanction {
  id         String       @id @default(cuid())
  userId     BigInt                                  // на кого наложена
  issuedById BigInt                                  // какой админ выдал
  type       SanctionType
  reason     String       @db.VarChar(500)
  createdAt  DateTime     @default(now())
  expiresAt  DateTime?                               // null = бессрочно (для WARN всегда null)
  revokedAt  DateTime?                               // снята вручную раньше срока

  user     User @relation("SanctionTarget", fields: [userId],     references: [id], onDelete: Cascade)
  issuedBy User @relation("SanctionIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([type])
  @@map("sanctions")
}

model DeviceSession {
  id               String    @id @default(cuid())
  userId           BigInt
  refreshTokenHash String    @unique
  deviceName       String?   @db.VarChar(255)
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("device_sessions")
}

// Schema only — email verification flow not yet implemented
model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     BigInt
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Одноразовый токен смены пароля. Выдаётся админом («ссылка для самостоятельной
// смены») — пользователь переходит по ссылке и сам ставит новый пароль.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     BigInt
  tokenHash  String    @unique               // sha256 от сырого токена из ссылки
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Chat {
  id        String   @id @default(cuid())
  type      ChatType @default(DIRECT)
  createdAt DateTime @default(now())

  members    ChatMember[]
  messages   Message[]
  events     CalendarEvent[]
  categories CalendarCategory[]
  settings   ChatCalendarSetting[]
  calls      CallSession[]

  @@map("chats")
}

model ChatMember {
  chatId            String
  userId            BigInt
  joinedAt          DateTime @default(now())
  lastReadMessageId String?
  lastReadAt        DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id        String      @id            // UUID v7 — time-ordered
  chatId    String
  senderId  BigInt
  content   String?
  type      MessageType @default(TEXT)
  createdAt DateTime    @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  pinnedAt  DateTime?                  // when this message was pinned in its chat
  replyToId String?                    // message this one replies to

  chat        Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User              @relation(fields: [senderId], references: [id])
  attachments Attachment[]
  reactions   MessageReaction[]
  replyTo     Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]         @relation("MessageReply")

  @@index([chatId, id])   // range scan for cursor pagination
  @@index([senderId])
  @@map("messages")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    BigInt
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    BigInt
  emoji     String   // e.g. "👍"
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model Attachment {
  id           String  @id @default(cuid())
  messageId    String
  storageKey   String          // MinIO object key
  mimeType     String
  sizeBytes    BigInt?
  width        Int?
  height       Int?
  durationMs   Int?            // audio / video
  thumbnailKey String?         // MinIO key for generated thumbnail
  waveform     Json?           // Float[] for audio waveform visualization

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

// ── Календарь чата ───────────────────────────────────────────
// Пользовательская категория событий внутри конкретного чата.
// Встроенные пресеты (планы, значимые даты и т.д.) хранятся в коде,
// здесь — только созданные участниками категории.
model CalendarCategory {
  id        String   @id @default(cuid())
  chatId    String
  name      String   @db.VarChar(40)
  color     String   @db.VarChar(9)   // hex "#RRGGBB" или "#RRGGBBAA"
  createdById BigInt
  createdAt DateTime @default(now())

  chat      Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdBy User            @relation("CategoryCreator", fields: [createdById], references: [id])
  events    CalendarEvent[]

  @@index([chatId])
  @@map("calendar_categories")
}

model CalendarEvent {
  id          String    @id @default(cuid())
  chatId      String
  createdById BigInt
  title       String    @db.VarChar(120)
  notes       String?   @db.VarChar(1000)
  // Момент события. allDay → берётся только дата (в TZ создателя сохраняем как полночь UTC).
  eventAt     DateTime
  allDay      Boolean   @default(false)
  // Категория: ровно одно из двух — пресет (presetKey) либо пользовательская (categoryId).
  presetKey   String?   @db.VarChar(32)
  categoryId  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chat      Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdBy User              @relation("EventCreator", fields: [createdById], references: [id])
  category  CalendarCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reminders EventReminder[]

  @@index([chatId, eventAt])
  @@map("calendar_events")
}

model EventReminder {
  id        String         @id @default(cuid())
  eventId   String
  // За сколько минут до eventAt напомнить (0 = в момент события).
  offsetMin Int            @default(0)
  // Кому шлём это напоминание.
  target    ReminderTarget @default(BOTH)
  // Включена ли отправка push/уведомления для этого напоминания.
  notify    Boolean        @default(true)
  // Вычисляется при создании/изменении: eventAt - offsetMin. Поле для выборки воркером.
  fireAt    DateTime
  // Когда воркер реально доставил (null = ещё в очереди).
  sentAt    DateTime?

  event      CalendarEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@index([sentAt, fireAt])   // воркер выбирает: sentAt IS NULL AND fireAt <= now()
  @@index([eventId])
  @@map("event_reminders")
}

// Факт доставки напоминания конкретному пользователю (для дедупликации и истории).
model ReminderDelivery {
  id         String   @id @default(cuid())
  reminderId String
  userId     BigInt
  deliveredAt DateTime @default(now())

  reminder EventReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reminderId, userId])
  @@index([userId])
  @@map("reminder_deliveries")
}

// Общий тумблер: получает ли пользователь напоминания из календаря этого чата.
model ChatCalendarSetting {
  chatId            String
  userId            BigInt
  remindersEnabled  Boolean @default(true)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_calendar_settings")
}

// ── Звонки ───────────────────────────────────────────────────
// Одна запись = один звонок в рамках чата. На Phase 1 — личные 1:1
// звонки (chat.type = DIRECT), но схема рассчитана на группы:
// участники вынесены в CallParticipant, а не зафиксированы двумя FK.
model CallSession {
  id          String     @id @default(cuid())
  chatId      String
  // Кто инициировал вызов.
  initiatorId BigInt
  media       CallMedia  @default(AUDIO)
  status      CallStatus @default(RINGING)

  createdAt   DateTime   @default(now())  // момент инициации (начало звонка)
  answeredAt  DateTime?                   // когда вызов был принят (→ ACTIVE)
  endedAt     DateTime?                   // когда звонок завершился
  // Длительность разговора в секундах (answeredAt → endedAt). 0 для неотвеченных.
  durationSec Int        @default(0)

  chat         Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  initiator    User              @relation("CallInitiator", fields: [initiatorId], references: [id])
  participants CallParticipant[]

  @@index([chatId, createdAt])
  @@index([initiatorId])
  @@map("call_sessions")
}

// Участник конкретного звонка. Для 1:1 их двое (инициатор + получатель).
model CallParticipant {
  id        String    @id @default(cuid())
  callId    String
  userId    BigInt
  joinedAt  DateTime?            // когда реально подключился к медиа (null = так и не вошёл)
  leftAt    DateTime?

  call CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId])
  @@map("call_participants")
}
